# =============================================================================
# AI Provider 格式配置
# 切换此值后重启服务即可完成 provider 切换，无需修改其它配置项
# 可选值: "gemini" (默认) | "openai"
# =============================================================================
AI_PROVIDER_FORMAT=gemini

# =============================================================================
# Gemini 格式配置（当 AI_PROVIDER_FORMAT=gemini 时使用）
# =============================================================================
GOOGLE_API_KEY=your-google-api-key-here
# 官方地址（需科学上网）: https://generativelanguage.googleapis.com
# 代理示例: https://aihubmix.com/gemini
GOOGLE_API_BASE=https://generativelanguage.googleapis.com
# 超时时间（秒），默认 300
GENAI_TIMEOUT=300.0
# 最大重试次数（应用层实现），图像传输数据量大偶发 SSL 中断，建议设为 3
GENAI_MAX_RETRIES=3

# =============================================================================
# OpenAI 格式配置（当 AI_PROVIDER_FORMAT=openai 时使用）
# =============================================================================
OPENAI_API_KEY=your-openai-api-key-here
# 官方地址: https://api.openai.com/v1
# 代理示例: https://aihubmix.com/v1
OPENAI_API_BASE=https://api.openai.com/v1
# 超时时间（秒），默认 300
OPENAI_TIMEOUT=300.0
# 最大重试次数，默认 2
OPENAI_MAX_RETRIES=2

# =============================================================================
# AI 模型配置
# 按 AI_PROVIDER_FORMAT 分别填写，切换 provider 时自动生效，无需手动修改
# =============================================================================

# Gemini 格式模型（AI_PROVIDER_FORMAT=gemini 时生效）
GENAI_TEXT_MODEL=gemini-2.5-flash
GENAI_IMAGE_MODEL=gemini-3-pro-image-preview
GENAI_IMAGE_CAPTION_MODEL=gemini-2.5-flash

# OpenAI 格式模型（AI_PROVIDER_FORMAT=openai 时生效，按实际可用模型名填写）
OPENAI_TEXT_MODEL=gpt-4o
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_CAPTION_MODEL=gpt-4o

# =============================================================================
# Flask 配置
# =============================================================================
LOG_LEVEL=INFO
FLASK_ENV=production
SECRET_KEY=your-secret-key-change-this-in-production
PORT=5000

# CORS 配置（多个地址用逗号分隔，* 表示允许所有来源）
CORS_ORIGINS=*

# 并发配置
MAX_DESCRIPTION_WORKERS=5
MAX_IMAGE_WORKERS=4

# =============================================================================
# MinerU 文件解析服务配置
# 免费 token 申请: https://mineru.net（有用量限制，建议自行申请）
# =============================================================================
MINERU_TOKEN=your-mineru-token-here
MINERU_API_BASE=https://mineru.net

# =============================================================================
# 可选功能配置
# =============================================================================

# 百度 OCR（用于可编辑 PPTX 导出，可选）
# 申请地址: https://cloud.baidu.com/product/ocr
BAIDU_OCR_API_KEY=your-baidu-api-key-here

# 输出语言: zh (中文) | en (English) | ja (日本語) | auto (跟随输入语言)
OUTPUT_LANGUAGE=zh

# =============================================================================
# 镜像源配置（国内用户如遇网络问题，取消对应注释即可）
# =============================================================================

# Docker Hub 镜像源（注意末尾斜杠）
# DOCKER_REGISTRY=docker.1ms.run/

# GitHub Container Registry 镜像源（注意末尾斜杠）
# GHCR_REGISTRY=ghcr.nju.edu.cn/

# Debian apt 镜像源
# APT_MIRROR=mirrors.aliyun.com

# PyPI 镜像源
# PYPI_INDEX_URL=https://mirrors.cloud.tencent.com/pypi/simple

# npm 镜像源（注意末尾斜杠）
# NPM_REGISTRY=https://registry.npmmirror.com/
